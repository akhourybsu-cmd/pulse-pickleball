# Copy to .env.production-secrets.local, fill it locally, and never commit the
# populated file. Existing Supabase-managed and email secrets are intentionally
# omitted from this template so they are not overwritten.

# Required for maps and paid flows before production cutover.
GOOGLE_MAPS_API_KEY=replace-me
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_LEAGUE_SLOT_PRICE_ID=replace-me

# Required to preserve web push. Reuse the existing pair if available; a new
# pair makes the five migrated browser subscriptions re-subscribe.
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_CONTACT=mailto:admin@pulsepb.com

# Optional until native push and simulation tooling are needed.
FCM_SERVICE_ACCOUNT_JSON=replace-or-remove-this-line
SIM_ADMIN_SECRET=replace-or-remove-this-line
