# Copy this file to `android/keystore.properties` and fill in real values.
# The real keystore.properties (and *.keystore/*.jks) are gitignored — NEVER commit them.
#
# Create the upload keystore once:
#   keytool -genkey -v -keystore pulse-upload.keystore \
#     -alias pulse-upload -keyalg RSA -keysize 2048 -validity 10000
#
# Then point storeFile at that file (absolute path is safest).

storeFile=/absolute/path/to/pulse-upload.keystore
storePassword=CHANGE_ME
keyAlias=pulse-upload
keyPassword=CHANGE_ME
